# Network this build talks to.
VITE_NETWORK_ID=preprod

# Preprod contract address. Empty until the contract is deployed.
VITE_CONTRACT_ADDRESS=

# Where the compiled proving keys and zkir are served from. A relative path is
# resolved against the page origin; an absolute http(s) URL is used as given.
VITE_ZK_CONFIG_BASE=/managed/cepush
